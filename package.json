{
  "name": "openfiat-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official public website for the OpenFiat project.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "content": "node scripts/fetch-content.mjs",
    "predev": "pnpm run content",
    "dev": "next dev",
    "prebuild": "pnpm run content",
    "build": "next build",
    "pretest": "pnpm run content",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tokenomics": "bash scripts/check-stale-tokenomics-literals.sh"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.0",
    "clsx": "^2.1.1",
    "hast-util-to-string": "^3.0.1",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
